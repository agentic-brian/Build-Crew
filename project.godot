; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Build Crew"
config/description="A tiny game about building one driveway, start to finish."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(1, 0.952941, 0.807843, 1)
; The publisher's wordmark on the family cream, built by `tools/make_splash.gd`
; from the logo under `tools/brand/` (behind a `.gdignore`, so it is never
; imported or exported). It carries WORDS, and it is the one place in this
; product that does: DESIGN 7g's rule is about what the GAME draws, and this is
; the mark of who made it, shown before the game starts - the same status as the
; name on the App Store listing. `stretch_mode` Keep, so the same picture lands
; on a desktop window, an iPad and a phone, and whatever a screen's shape
; letterboxes is the same cream as `bg_color`.
boot_splash/image="res://assets/brand/splash.png"
; The skid steer wearing its push blade, rendered from the game's own GLB by
; `tools/make_appicon.gd`. No words: an icon is the first thing a child sees.
config/icon="res://assets/brand/appicon/icon_1024.png"

[debug]

; The engine's own default is `enable_file_logging=false` with
; `enable_file_logging.pc=true`, so on every desktop run it was writing
; `user://logs/godot<date>T<time>.log` - filenames that are literally a history
; of when this app was opened, beside the two files the privacy policy names,
; with the GPU and device in them. Both keys are pinned, because the base one
; alone is still beaten by the engine's own `.pc`. `privacy_probe` reads this
; through `get_setting_with_override`, which is what the engine reads: plain
; `get_setting` does NOT apply feature tags, and that is why the check was
; green while the logs were being written.
file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/theme/build_crew.tres"

[rendering]

; The iOS export refuses to run without this, with an EMPTY error string
; (car-fixer/docs/ios_release.md). This project ships no textures, so it costs
; nothing here and saves an afternoon later.
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
