; Car Garage's default look, by Big Little Jobs - Tree Crew's
; `assets/theme/tree_crew.tres` (from its repository), for this game.
;
; Only the BODY face lives here, and it lives here rather than in code so that
; a Control nobody has thought about - a future menu, a debug panel, a Godot
; built-in dialog - is already speaking the brand's interface type before any
; script runs. Display type (the title, YAY!) is asked for by
; name at each of the handful of places that want it: see `Brand.stamp`.
;
; Nunito Sans is a variable file and this is its 850 weight, which is what the
; Big Little Jobs website sets its own interface text at.
[gd_resource type="Theme" load_steps=3 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/NunitoSans.woff2" id="1_body"]

[sub_resource type="FontVariation" id="FontVariation_body"]
base_font = ExtResource("1_body")
variation_opentype = {
"wght": 850
}

[resource]
default_font = SubResource("FontVariation_body")
