[gd_resource type="Resource" script_class="JobDef" load_steps=30 format=3]

; NEW DRIVEWAY - the job the level was built around (DESIGN 2), as data.
;
; The nine phases the user asked for, in their order, plus the beats that fetch
; and send away the machines, and since the plan's fifth session (2026-09-15)
; the four the user chose to add: each truck's reverse leg is the child's hold,
; the base is packed with a plate compactor, the kerb board and its two pegs go
; in AFTER the base (the trucks back through that end), and the child strips
; their own forms after the cure. Twenty-five rows.
;
; Eighty-three progress stops, weighted by the child's MINUTES rather than their
; taps (the improvement plan's 3.6): the jackhammer's twelve bites, two pushes
; (4), four boards, ten stakes, the base (2), three bays of the plate (6), twelve
; bars, the POUR (6) and the come-along (8), the water (4), the screed (4), two
; joints, three bays of broom (6) and three boards stripped. Calling a machine on
; is worth 0 - pressing a button is not a child's WORK - and so is waving a truck
; back in and waiting for the cure, so the bar's last stop is the last board off.
;
; kind: 0 TAP, 1 BUTTON, 2 AUTO, 3 HOLD.
;
; Every HOLD runs only while the finger is down and pauses where it is when it
; lifts. The pour is the one beat steered with the four PADS (SiteMain._process);
; the water, the plate and the broom are worked by DRAGGING the finger over the
; slab, and they only happen where the finger (or the tool it holds) is.

[ext_resource type="Script" path="res://scripts/job_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/job_step.gd" id="2_step"]
[ext_resource type="Script" path="res://scripts/slab_spec.gd" id="3_slab"]

; 1. BREAK IT UP. Six panels of old concrete, THREE BITES EACH, in three
;    different places on the slab - the arrow walks to a different third of the
;    panel every time and the tap has to land near it. The third bite is the one
;    the slab lets go on. Seen low and close across the spot being hit.
[sub_resource type="Resource" id="Step_jack"]
script = ExtResource("2_step")
kind = 0
target = "Jack_*"
verb = "jack_spot"
tool = "jackhammer"
shot = "PANEL"
count = 12
sound = "whoosh"
progress_weight = 1

; 2. The big green button: the skid steer comes up the street, and the garage
;    door goes up in front of it.
[sub_resource type="Resource" id="Step_call_skid"]
script = ExtResource("2_step")
kind = 1
target = ""
verb = "call_skid"
tool = "none"
shot = "WIDE"
count = 1
sound = ""
progress_weight = 0

; 3. PUSH IT OUT. Two passes, one per COLUMN of the old drive, each the whole
;    nine metres: the machine starts inside the garage, the child crawls it down
;    the drive on the picture, and it swings off the end onto the heap.
[sub_resource type="Resource" id="Step_push"]
script = ExtResource("2_step")
kind = 3
target = "Rubble_*"
verb = "push_rubble"
tool = "none"
shot = "MACHINE"
count = 2
sound = ""
progress_weight = 2

[sub_resource type="Resource" id="Step_skid_off"]
script = ExtResource("2_step")
kind = 2
target = ""
verb = "skid_leave"
tool = "none"
shot = "WIDE"
count = 1
sound = ""
progress_weight = 0

; 5. THE FORMS. The two long boards and the expansion strip, one tap each -
;    setting a board is one decisive move, not a hold - seen low along the edge
;    of the hole the board goes on. The KERB board is not in this row: the
;    trucks back through that end, so it goes in after the base (5b).
[sub_resource type="Resource" id="Step_forms"]
script = ExtResource("2_step")
kind = 0
target = "Form_*"
verb = "form_set"
tool = "none"
shot = "FORM"
count = 3
sound = ""
progress_weight = 1

; 6. THE STAKES. Eight of them - the long boards' - ONE BLOW OF THE SLEDGE
;    EACH, right down on the peg being hit.
[sub_resource type="Resource" id="Step_stakes"]
script = ExtResource("2_step")
kind = 0
target = "Stake_*"
verb = "stake_drive"
tool = "sledge"
shot = "STAKE"
count = 8
sound = "whoosh"
progress_weight = 1

; 7. The button again: the dump truck comes down the street and stops, tail to
;    the drive, waiting.
[sub_resource type="Resource" id="Step_call_dump"]
script = ExtResource("2_step")
kind = 1
target = ""
verb = "call_dump"
tool = "none"
shot = "WIDE"
count = 1
sound = ""
progress_weight = 0

; 7b. BACK IT IN. The child is the banksman: a finger on the truck and it backs
;     up the drive, beeping, only while the finger is down (decision 4). Worth
;     nothing on the bar - guiding a truck is not the job's work - and its
;     target is `Back:`, not `Machine:`, so a finger still down when it stops
;     does not start the tip under a camera that is still moving.
[sub_resource type="Resource" id="Step_back_dump"]
script = ExtResource("2_step")
kind = 3
target = "Back:DumpTruck"
verb = "back_dump"
tool = "none"
shot = "STREET"
count = 1
sound = ""
progress_weight = 0

; 8. THE BASE. Press and hold: the bed goes up, the limestone runs out, and the
;    truck drives out as it tips so the load lays as a windrow up the drive.
[sub_resource type="Resource" id="Step_base"]
script = ExtResource("2_step")
kind = 3
target = "Machine:DumpTruck"
verb = "tip_gravel"
tool = "none"
shot = "TIPPER"
count = 1
sound = ""
progress_weight = 2

[sub_resource type="Resource" id="Step_dump_off"]
script = ExtResource("2_step")
kind = 2
target = ""
verb = "dump_leave"
tool = "none"
shot = "WIDE"
count = 1
sound = ""
progress_weight = 0

; 8b. PACK IT DOWN (decision 6). The plate compactor, one bay of the base per
;     beat, DRAGGED: a finger on the plate walks it over the stone, the stones
;     go flat and the gravel a step paler wherever it has been, and the picture
;     rattles while it works. A finger held still packs only the plate's own
;     patch.
[sub_resource type="Resource" id="Step_compact"]
script = ExtResource("2_step")
kind = 3
target = "Slab"
verb = "compact_base"
tool = "plate"
shot = "PLATE"
count = 1
sound = ""
progress_weight = 6

; 8c. CLOSE THE FORM (decision 5). The kerb board, from the road, now the
;     trucks that backed through that end have gone...
[sub_resource type="Resource" id="Step_kerb_form"]
script = ExtResource("2_step")
kind = 0
target = "Form_3"
verb = "form_set"
tool = "none"
shot = "FORM"
count = 1
sound = ""
progress_weight = 1

; 8d. ...and its two pegs, from the road's edge.
[sub_resource type="Resource" id="Step_kerb_stakes"]
script = ExtResource("2_step")
kind = 0
target = "Stake_9"
verb = "stake_drive"
tool = "sledge"
shot = "STAKE"
count = 2
sound = "whoosh"
progress_weight = 1

; 9b. THE STEEL (DESIGN 2d). Twelve bars, one tap each: the four long ones onto
;     their chairs first, then the cross bars in pairs down the drive, tied where
;     they cross. The bars sit UP off the base so they end in the middle of the
;     slab - that is the lesson - and no wheel ever goes over them, which is why
;     the mixer stays on the road for the pour.
[sub_resource type="Resource" id="Step_rebar"]
script = ExtResource("2_step")
kind = 0
target = "Bar_*"
verb = "rebar_lay"
tool = "none"
shot = "BARS"
count = 12
sound = ""
progress_weight = 1

; 10. The button once more: the mixer comes down the street and stops, waiting
;     to be backed to the kerb.
[sub_resource type="Resource" id="Step_call_mixer"]
script = ExtResource("2_step")
kind = 1
target = ""
verb = "call_mixer"
tool = "none"
shot = "WIDE"
count = 1
sound = ""
progress_weight = 0

; 10b. BACK IT TO THE KERB - and no further, because the steel is down. The
;      child's hold again; then the chute comes out.
[sub_resource type="Resource" id="Step_back_mixer"]
script = ExtResource("2_step")
kind = 3
target = "Back:ConcreteTruck"
verb = "back_mixer"
tool = "none"
shot = "STREET"
count = 1
sound = ""
progress_weight = 0

; 11. THE POUR - the centrepiece (DESIGN 2a). The truck stops being drawn and the
;     camera comes right up to the chute, so what is on screen is the thing the
;     child is steering and the form it is filling. LEFT and RIGHT swing the chute
;     across the form, UP and DOWN walk the pour down the drive and back. It ends
;     when every cell of the form is up to grade. Worth six stops of the bar, and
;     the only beat that cannot be finished by holding still.
[sub_resource type="Resource" id="Step_pour"]
script = ExtResource("2_step")
kind = 3
target = "Machine:ConcreteTruck"
verb = "pour_chute"
tool = "none"
shot = "CHUTE"
count = 1
sound = ""
progress_weight = 6

; 11b. PULL IT UP. The chute keeps running into the kerb end; the child DRAGS the
;      come-along and the concrete comes up the form to it, a stroke at a time,
;      from where the chute leaves it. Seen from the garage door, looking down
;      the drive at the concrete coming toward you. It ends when every cell of
;      the form is up to grade: the filling game the user asked for.
[sub_resource type="Resource" id="Step_rake"]
script = ExtResource("2_step")
kind = 3
target = "Slab"
verb = "rake_pull"
tool = "rake"
shot = "PULL"
count = 1
sound = ""
progress_weight = 8

[sub_resource type="Resource" id="Step_mixer_off"]
script = ExtResource("2_step")
kind = 2
target = ""
verb = "mixer_leave"
tool = "none"
shot = "WIDE"
count = 1
sound = ""
progress_weight = 0

; 13. WATER. DRAGGED: the nozzle goes where the finger goes and the slab comes up
;     dark behind it. It ends when there is no pale concrete left.
[sub_resource type="Resource" id="Step_water"]
script = ExtResource("2_step")
kind = 3
target = "Slab"
verb = "spray_water"
tool = "hose"
shot = "HAND"
count = 1
sound = ""
progress_weight = 4

; 14. THE BOARD. A 4.2 m screed pulled up the drive on the form tops, sawing
;     side to side: flat behind it, lumpy in front of it.
[sub_resource type="Resource" id="Step_screed"]
script = ExtResource("2_step")
kind = 3
target = "Slab"
verb = "screed_pull"
tool = "screed"
shot = "SURFACE"
count = 1
sound = ""
progress_weight = 4

; 15. THE JOINTS. Two control joints across the slab, a third and two thirds
;     along: a slab this long cracks where it likes unless it is told where to.
;     Seen square on to the line, so both ends of it are in the picture.
[sub_resource type="Resource" id="Step_joints"]
script = ExtResource("2_step")
kind = 3
target = "Joint_*"
verb = "joint_cut"
tool = "jointer"
shot = "JOINT"
count = 2
sound = ""
progress_weight = 1

; 16. THE BROOM. DRAGGED, like the water: the brushed lines appear under the
;     finger and the slab dries pale where it has been finished.
[sub_resource type="Resource" id="Step_broom"]
script = ExtResource("2_step")
kind = 3
target = "Slab"
verb = "broom_finish"
tool = "broom"
shot = "BROOM"
count = 3
sound = ""
progress_weight = 2

; 17. LATER THAT DAY. The cones go across the mouth of the drive and the light
;     goes to evening while the slab goes off: boards do not come off concrete
;     that was broomed a second ago. Nothing to do, so worth nothing.
[sub_resource type="Resource" id="Step_cure"]
script = ExtResource("2_step")
kind = 2
target = ""
verb = "slab_cure"
tool = "none"
shot = "WIDE"
count = 1
sound = ""
progress_weight = 0

; 18. STRIP THE FORMS (the plan's 5.3). What the child put in, the child takes
;     out: three boards, one tap each, in any order - the pegs are drawn, the
;     board is prised off the clean edge of the new slab and laid on the grass,
;     and the earth goes back against the concrete. The last board is the tada.
[sub_resource type="Resource" id="Step_strip"]
script = ExtResource("2_step")
kind = 0
target = "Form_*"
verb = "form_strip"
tool = "none"
shot = "STRIP"
count = 3
sound = "whoosh"
progress_weight = 1

; THE RECTANGLE this job is poured into (6.5). These are the numbers the
; driveway has always had, written down where the job can see them instead of
; being constants in `Driveway`: 3.6 m across, from the garage apron at z -3.4
; to the kerb at z 5.6, filled on a 6 x 12 grid, with the old slab two panels by
; two. `SlabSpec` holds no LEVELS - grade, the base and the dig are the same for
; any slab a child pours - and `SiteMain._enter_tree` stands this up before the
; Driveway builds itself.
[sub_resource type="Resource" id="Slab_drive"]
script = ExtResource("3_slab")
centre_x = 2.6
z_apron = -3.4
z_kerb = 5.6
width = 3.6
cells_x = 6
cells_z = 12
panels_x = 2
panels_z = 2

[resource]
script = ExtResource("1_def")
name = "New driveway"
slab = SubResource("Slab_drive")
arrives_with = "old_drive"
payoff = "park_on_it"
steps = Array[ExtResource("2_step")]([SubResource("Step_jack"), SubResource("Step_call_skid"), SubResource("Step_push"), SubResource("Step_skid_off"), SubResource("Step_forms"), SubResource("Step_stakes"), SubResource("Step_call_dump"), SubResource("Step_back_dump"), SubResource("Step_base"), SubResource("Step_dump_off"), SubResource("Step_compact"), SubResource("Step_kerb_form"), SubResource("Step_kerb_stakes"), SubResource("Step_rebar"), SubResource("Step_call_mixer"), SubResource("Step_back_mixer"), SubResource("Step_pour"), SubResource("Step_rake"), SubResource("Step_mixer_off"), SubResource("Step_water"), SubResource("Step_screed"), SubResource("Step_joints"), SubResource("Step_broom"), SubResource("Step_cure"), SubResource("Step_strip")])
